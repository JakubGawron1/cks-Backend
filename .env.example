PRODUCTION_MODE=dev
DATABASE_URL=file:./data/slavia.db

# Produkcja (Turso) — ustaw na HF Space / Render:
# PRODUCTION_MODE=production
# DATABASE_URL=libsql://YOUR-DB.turso.io
# TURSO_AUTH_TOKEN=
# (alias URL: TURSO_DATABASE_URL)

JWT_SECRET=zmien-mnie-na-dlugi-losowy-sekret-dev
JWT_EXPIRY_HOURS=72
HOST=0.0.0.0
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Jedyny seed: konto z najwyższymi uprawnieniami
SEED_SUPERADMIN_EMAIL=superadmin@cks-slavia.local
SEED_SUPERADMIN_PASSWORD=superadmin123!

# Na hostingu (HF Space / Render) wymagane:
#   PRODUCTION_MODE=production
#   DATABASE_URL (libsql://…), TURSO_AUTH_TOKEN
#   JWT_SECRET, FRONTEND_ORIGIN, SEED_SUPERADMIN_PASSWORD
# HF Space: https://koliber-cks-slavia.hf.space
# Szczegóły: deploy.md

# Zdjęcia (domyślnie ImageKit). Cloudinary — później, patrz Todo.md.
# IMAGE_PROVIDER=imagekit
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# Endpoint z dashboardu ImageKit (może zawierać path, np. …/id/slavia).
# Folder uploadu to /avatars — nie doklejaj tego samego path w folderze.
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ID

# E-mail (Brevo). W dev domyślnie tylko log; w production włącza się gdy jest BREVO_API_KEY.
# EMAIL_ENABLED=false
# BREVO_API_KEY=
# Nadawca musi być zweryfikowany w Brevo (Senders). Cudzysłów obowiązkowy przy spacjach:
# EMAIL_FROM="CKS Slavia <twoj@email.pl>"
# Z własną domeną (po weryfikacji DNS w Brevo):
# EMAIL_FROM="Slavia <noreply@twoja-domena.pl>"
